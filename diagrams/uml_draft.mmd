classDiagram
    direction LR

    class Owner {
        +String name
        +List~Pet~ pets
        +int available_minutes
        +int day_start_minutes
        +add_pet(pet: Pet) void
        +all_tasks() list
        +pending_tasks() list
    }

    class Pet {
        +String name
        +String animal_type
        +List~Task~ tasks
        +add_task(task: Task) void
    }

    class Task {
        +String title
        +int duration_minutes
        +Priority priority
        +String frequency
        +bool is_completed
        +mark_complete() void
        +mark_incomplete() void
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +build_plan(owner: Owner) Schedule
        +reset_for_new_day(owner: Owner) int
        -sort_tasks(pet_tasks: list) list
        -fits(task: Task, used_minutes: int, budget_minutes: int) bool
    }

    class Schedule {
        +List~ScheduledTask~ entries
        +list skipped
        +int total_minutes derived
        +add_entry(entry: ScheduledTask) void
        +summary() String
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +int start_minutes
        +String start_time derived
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Task --> Priority : rated by
    Scheduler ..> Owner : reads pets and constraints
    Scheduler --> Schedule : produces
    Schedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask --> Task : places
    ScheduledTask --> Pet : for

    note for Schedule "skipped holds (Pet, Task) pairs, so a skipped line can name its pet"
    note for Scheduler "sort_tasks takes and returns (Pet, Task) pairs, keeping the pet through the sort"
